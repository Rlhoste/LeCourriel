import { Theme } from "theme.slint";
import { EmailCard, EmailCardData } from "email_card.slint";
import { ReadingPane } from "reading_pane.slint";
import { ScrollView } from "std-widgets.slint";

export component InboxPanel inherits Rectangle {
    background: Theme.bg-primary;

    in property <[EmailCardData]> all-emails;
    in property <string> greeting;
    in property <string> briefing-time;
    in property <bool> loading;
    in-out property <int> active-uid: -1;
    in property <string> reading-from;
    in property <string> reading-subject;
    in property <string> reading-date;
    in property <string> reading-body;

    callback view-clicked(int);
    callback reply-clicked(int);

    VerticalLayout {
        spacing: 0px;

        // Top bar
        Rectangle {
            height: 72px;
            background: Theme.bg-primary;

            HorizontalLayout {
                padding-left: 28px;
                padding-right: 24px;
                spacing: 0px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;

                    Text {
                        text: greeting;
                        color: Theme.text-primary;
                        font-size: Theme.font-xl;
                        font-weight: 700;
                    }
                    Text {
                        text: briefing-time;
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                    }
                }

                if loading: Rectangle {
                    width: 90px;
                    height: 30px;
                    border-radius: Theme.radius-md;
                    background: Theme.bg-card;
                    y: (72px - 30px) / 2;

                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 6px;
                        alignment: start;

                        spinner := Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.accent;
                            y: (30px - 8px) / 2;

                            animate opacity {
                                duration: 600ms;
                                iteration-count: -1;
                                direction: alternate;
                                easing: ease-in-out;
                            }
                        }
                        Text {
                            text: "Fetching…";
                            color: Theme.text-secondary;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                            height: 30px;
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // Split view
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Email list
            Rectangle {
                horizontal-stretch: 2;
                background: Theme.bg-sidebar;

                ScrollView {
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        width: parent.visible-width;
                        padding: 12px;
                        spacing: 6px;

                        if all-emails.length == 0: Text {
                            text: "No emails";
                            color: Theme.text-muted;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                        }

                        for email in all-emails: EmailCard {
                            width: parent.width;
                            card-data: email;
                            view-clicked(uid) => { root.view-clicked(uid); }
                            reply-clicked(uid) => { root.reply-clicked(uid); }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.border; }

            ReadingPane {
                horizontal-stretch: 3;
                has-email: active-uid >= 0;
                from-header: reading-from;
                subject-header: reading-subject;
                date-header: reading-date;
                body-text: reading-body;
                reply-clicked => { root.reply-clicked(active-uid); }
            }
        }
    }
}
