import { Theme } from "theme.slint";
import { EmailCardData } from "email_card.slint";

export struct WeekDayData {
    day-name: string,
    day-number: int,
    is-today: bool,
    dl1-subject: string,
    dl1-uid: int,
    dl2-subject: string,
    dl2-uid: int,
    dl3-subject: string,
    dl3-uid: int,
}

// Generic mini-list box for Last, Important, Tasks
component OverviewBox inherits Rectangle {
    in property <string> box-title;
    in property <color> accent-color: Theme.accent;
    in property <[EmailCardData]> items;

    callback item-clicked(int);

    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 12px;
        spacing: 8px;

        // Header
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 3px;
                height: 14px;
                border-radius: 2px;
                background: accent-color;
                y: 2px;
            }
            Text {
                text: box-title;
                color: Theme.text-primary;
                font-size: Theme.font-sm;
                font-weight: 700;
            }
        }

        // Email rows (up to 5)
        for item[idx] in items: Rectangle {
            visible: idx < 5;
            height: idx < 5 ? 22px : 0px;

            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.item-clicked(item.uid); }
            }

            background: row-touch.has-hover ? Theme.btn-ghost-hover : transparent;
            border-radius: Theme.radius-sm;

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 6px;
                alignment: start;

                // Bullet dot
                Rectangle {
                    width: 5px;
                    height: 5px;
                    border-radius: 3px;
                    background: Theme.text-muted;
                    y: (22px - 5px) / 2;
                }

                // Subject
                Text {
                    text: item.subject;
                    color: Theme.text-primary;
                    font-size: Theme.font-xs;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    height: 22px;
                }

                // Date
                Text {
                    text: item.date-str;
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                    height: 22px;
                }
            }
        }

        if items.length == 0: Text {
            text: "No items";
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            horizontal-alignment: center;
        }
    }
}

// Tasks box — shows the extracted task text, not the email subject
component TaskBox inherits Rectangle {
    in property <string> box-title;
    in property <[EmailCardData]> items;

    callback item-clicked(int);

    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 3px; height: 14px;
                border-radius: 2px;
                background: Theme.dot-task;
                y: 2px;
            }
            Text {
                text: box-title;
                color: Theme.text-primary;
                font-size: Theme.font-sm;
                font-weight: 700;
            }
        }

        for item[idx] in items: Rectangle {
            visible: idx < 5;
            height: idx < 5 ? 22px : 0px;

            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.item-clicked(item.uid); }
            }
            background: row-touch.has-hover ? Theme.btn-ghost-hover : transparent;
            border-radius: Theme.radius-sm;

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 6px;
                alignment: start;

                Rectangle {
                    width: 5px; height: 5px;
                    border-radius: 3px;
                    background: Theme.dot-task;
                    y: (22px - 5px) / 2;
                }
                Text {
                    text: item.task == "" ? item.subject : item.task;
                    color: Theme.text-primary;
                    font-size: Theme.font-xs;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    height: 22px;
                }
            }
        }

        if items.length == 0: Text {
            text: "No tasks";
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            horizontal-alignment: center;
        }
    }
}

// Meetings box — shows meeting-link below subject, clicking opens URL
component MeetingsBox inherits Rectangle {
    in property <string> box-title;
    in property <[EmailCardData]> items;

    callback open-url(string);

    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 12px;
        spacing: 8px;

        // Header
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 3px;
                height: 14px;
                border-radius: 2px;
                background: #4a9eff;
                y: 2px;
            }
            Text {
                text: box-title;
                color: Theme.text-primary;
                font-size: Theme.font-sm;
                font-weight: 700;
            }
        }

        // Meeting rows (up to 5)
        for item[idx] in items: Rectangle {
            visible: idx < 5;
            height: idx < 5 ? 38px : 0px;

            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-url(item.meeting-link); }
            }

            background: row-touch.has-hover ? Theme.btn-ghost-hover : transparent;
            border-radius: Theme.radius-sm;

            VerticalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 2px;
                alignment: center;

                Text {
                    text: item.subject;
                    color: Theme.text-primary;
                    font-size: Theme.font-xs;
                    overflow: elide;
                }
                Text {
                    text: item.meeting-link;
                    color: #4a9eff;
                    font-size: Theme.font-xs;
                    overflow: elide;
                }
            }
        }

        if items.length == 0: Text {
            text: "No meetings";
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            horizontal-alignment: center;
        }
    }
}

export component OverviewPanel inherits Rectangle {
    background: Theme.bg-primary;

    in property <string> briefing-time;
    in property <[EmailCardData]> last-emails;
    in property <[EmailCardData]> important-emails;
    in property <[EmailCardData]> task-items;
    in property <[EmailCardData]> meeting-items;
    in property <[WeekDayData]> week-days;

    callback view-clicked(int);
    callback open-url(string);
    callback navigate(string);  // switch active panel

    VerticalLayout {
        spacing: 0px;

        // Header bar
        Rectangle {
            height: 56px;
            background: Theme.bg-primary;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;

                Text {
                    text: "Overview";
                    color: Theme.text-primary;
                    font-size: Theme.font-xl;
                    font-weight: 700;
                    vertical-alignment: center;
                    height: 56px;
                }
                Text {
                    text: briefing-time;
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    height: 56px;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "v2";
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                    height: 56px;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // Main content
        VerticalLayout {
            padding: 16px;
            spacing: 16px;
            vertical-stretch: 1;

            // 2×2 summary boxes — equal size both axes
            Rectangle {
                vertical-stretch: 2;
                clip: true;

                // Top row
                OverviewBox {
                    x: 0; y: 0;
                    width: (parent.width - 12px) / 2;
                    height: (parent.height - 12px) / 2;
                    box-title: "Last";
                    accent-color: Theme.text-muted;
                    items: last-emails;
                    item-clicked(uid) => { root.view-clicked(uid); root.navigate("inbox"); }
                }
                OverviewBox {
                    x: (parent.width - 12px) / 2 + 12px;
                    y: 0;
                    width: (parent.width - 12px) / 2;
                    height: (parent.height - 12px) / 2;
                    box-title: "Important";
                    accent-color: Theme.dot-urgent;
                    items: important-emails;
                    item-clicked(uid) => { root.view-clicked(uid); root.navigate("triage"); }
                }
                // Bottom row
                TaskBox {
                    x: 0;
                    y: (parent.height - 12px) / 2 + 12px;
                    width: (parent.width - 12px) / 2;
                    height: (parent.height - 12px) / 2;
                    box-title: "Tasks";
                    items: task-items;
                    item-clicked(uid) => { root.view-clicked(uid); root.navigate("tasks"); }
                }
                MeetingsBox {
                    x: (parent.width - 12px) / 2 + 12px;
                    y: (parent.height - 12px) / 2 + 12px;
                    width: (parent.width - 12px) / 2;
                    height: (parent.height - 12px) / 2;
                    box-title: "Meetings";
                    items: meeting-items;
                    open-url(url) => { root.open-url(url); }
                }
            }

            // Week calendar strip
            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "This Week";
                        color: Theme.text-primary;
                        font-size: Theme.font-sm;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 4px;

                        for day in week-days: Rectangle {
                            horizontal-stretch: 1;
                            background: day.is-today ? #1e3a5f : transparent;
                            border-radius: Theme.radius-sm;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                alignment: start;

                                // Day name
                                Text {
                                    text: day.day-name;
                                    color: day.is-today ? #6ab0f5 : Theme.text-muted;
                                    font-size: Theme.font-xs;
                                    font-weight: day.is-today ? 700 : 400;
                                    horizontal-alignment: center;
                                }

                                // Day number
                                Text {
                                    text: day.day-number;
                                    color: day.is-today ? #6ab0f5 : Theme.text-primary;
                                    font-size: Theme.font-md;
                                    font-weight: day.is-today ? 700 : 400;
                                    horizontal-alignment: center;
                                }

                                // Deadline pill 1
                                if day.dl1-subject != "": Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: #3a1e1e;

                                    pill1-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.view-clicked(day.dl1-uid); }
                                    }

                                    Text {
                                        x: 4px;
                                        y: 0;
                                        width: parent.width - 8px;
                                        height: parent.height;
                                        text: day.dl1-subject;
                                        color: #f58c6a;
                                        font-size: Theme.font-xs;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                // Deadline pill 2
                                if day.dl2-subject != "": Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: #3a1e1e;

                                    pill2-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.view-clicked(day.dl2-uid); }
                                    }

                                    Text {
                                        x: 4px;
                                        y: 0;
                                        width: parent.width - 8px;
                                        height: parent.height;
                                        text: day.dl2-subject;
                                        color: #f58c6a;
                                        font-size: Theme.font-xs;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                // Deadline pill 3
                                if day.dl3-subject != "": Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: #3a1e1e;

                                    pill3-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.view-clicked(day.dl3-uid); }
                                    }

                                    Text {
                                        x: 4px;
                                        y: 0;
                                        width: parent.width - 8px;
                                        height: parent.height;
                                        text: day.dl3-subject;
                                        color: #f58c6a;
                                        font-size: Theme.font-xs;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
