import { Theme } from "theme.slint";
import { Sidebar } from "sidebar.slint";
import { InboxPanel } from "inbox_panel.slint";
import { MainPanel } from "main_panel.slint";
import { TasksPanel } from "tasks_panel.slint";
import { ProjectsPanel, ProjectData } from "projects_panel.slint";
import { CalendarPanel, DeadlineData } from "calendar_panel.slint";
import { ComposeDialog } from "compose_dialog.slint";
import { EmailCardData } from "email_card.slint";
import { OverviewPanel, WeekDayData } from "overview_panel.slint";
import { SettingsDialog, AccountData } from "settings_dialog.slint";
import { FolderPanel } from "folder_panel.slint";

export { DeadlineData, ProjectData, WeekDayData, AccountData }

export component AppWindow inherits Window {
    title: "Courriel";
    background: Theme.bg-primary;
    preferred-width: 1200px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 500px;

    // ── Navigation ────────────────────────────────────────────────────────
    in-out property <string> active-panel: "overview";
    in-out property <string> active-triage-tab: "urgent";
    in-out property <int> active-email-uid: -1;

    // ── Core data from Rust ───────────────────────────────────────────────
    in-out property <string> greeting: "Good morning.";
    in-out property <string> briefing-time: "Briefed just now";
    in-out property <bool> loading: false;

    in-out property <[EmailCardData]> all-emails;
    in-out property <[EmailCardData]> urgent-emails;
    in-out property <[EmailCardData]> high-emails;
    in-out property <[EmailCardData]> other-emails;
    in-out property <[EmailCardData]> info-emails;
    in-out property <[EmailCardData]> threat-emails;
    in-out property <[EmailCardData]> task-emails;
    in-out property <[EmailCardData]> task-items;
    in-out property <[EmailCardData]> meeting-items;
    in-out property <[EmailCardData]> important-emails;
    in-out property <[EmailCardData]> all-emails-by-priority;

    // ── Sent / Drafts / Trash ─────────────────────────────────────────────
    in-out property <[EmailCardData]> sent-emails;
    in-out property <[EmailCardData]> drafts-emails;
    in-out property <[EmailCardData]> trash-emails;

    // ── Overview ──────────────────────────────────────────────────────────
    in-out property <[WeekDayData]> week-days;

    // ── Projects ──────────────────────────────────────────────────────────
    in-out property <[ProjectData]> projects;

    // ── Calendar ──────────────────────────────────────────────────────────
    in-out property <[DeadlineData]> deadlines;
    in-out property <int> calendar-year: 2026;
    in-out property <int> calendar-month: 10;

    // ── Reading pane ──────────────────────────────────────────────────────
    in-out property <string> reading-from;
    in-out property <string> reading-subject;
    in-out property <string> reading-date;
    in-out property <string> reading-body;

    // ── Compose dialog ────────────────────────────────────────────────────
    in-out property <bool> compose-open: false;
    in-out property <string> compose-to;
    in-out property <string> compose-subject;
    in-out property <string> compose-body;
    in-out property <string> compose-status;

    // ── Settings ──────────────────────────────────────────────────────────
    in-out property <bool> settings-open: false;
    in-out property <[AccountData]> settings-accounts;
    in-out property <string> settings-display-name;
    in-out property <string> settings-claude-key;
    in-out property <string> settings-claude-model;
    in-out property <string> settings-qr-text;
    in-out property <string> settings-save-status;
    in-out property <float> font-scale <=> Theme.font-scale;

    // ── Callbacks ─────────────────────────────────────────────────────────
    callback refresh-clicked();
    callback reply-clicked(int);
    callback view-clicked(int);
    callback send-email(string, string, string);
    callback open-url(string);
    callback save-description(string, string);
    callback save-settings(string, [AccountData], string, string, float);
    callback add-account();
    callback delete-account(int);
    callback request-qr();

    // ── Layout ────────────────────────────────────────────────────────────
    HorizontalLayout {
        spacing: 0px;

        Sidebar {
            active-panel: root.active-panel;
            inbox-count: root.urgent-emails.length + root.high-emails.length;
            triage-count: root.urgent-emails.length + root.high-emails.length;
            task-count: root.task-items.length;
            project-count: root.projects.length;
            deadline-count: root.deadlines.length;
            sent-count: root.sent-emails.length;
            drafts-count: root.drafts-emails.length;
            trash-count: root.trash-emails.length;

            panel-changed(p) => { root.active-panel = p; }
            compose-clicked => { root.compose-open = true; }
            refresh-clicked => { root.refresh-clicked(); }
            settings-clicked => { root.settings-open = true; }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        // Panel switcher
        Rectangle {
            horizontal-stretch: 1;

            if root.active-panel == "overview": OverviewPanel {
                width: parent.width; height: parent.height;
                briefing-time: root.briefing-time;
                last-emails: root.all-emails;
                important-emails: root.important-emails;
                task-items: root.task-items;
                meeting-items: root.meeting-items;
                week-days: root.week-days;
                view-clicked(uid) => { root.view-clicked(uid); }
                open-url(url) => { root.open-url(url); }
                navigate(panel) => { root.active-panel = panel; }
            }

            if root.active-panel == "inbox": InboxPanel {
                width: parent.width;
                height: parent.height;
                all-emails: root.all-emails;
                greeting: root.greeting;
                briefing-time: root.briefing-time;
                loading: root.loading;
                active-uid: root.active-email-uid;
                reading-from: root.reading-from;
                reading-subject: root.reading-subject;
                reading-date: root.reading-date;
                reading-body: root.reading-body;
                view-clicked(uid) => { root.view-clicked(uid); }
                reply-clicked(uid) => {
                    root.reply-clicked(uid);
                    root.compose-open = true;
                }
            }

            if root.active-panel == "triage": MainPanel {
                width: parent.width;
                height: parent.height;
                greeting: root.greeting;
                briefing-time: root.briefing-time;
                loading: root.loading;
                urgent-emails: root.urgent-emails;
                high-emails: root.high-emails;
                other-emails: root.other-emails;
                info-emails: root.info-emails;
                threat-emails: root.threat-emails;
                task-emails: root.task-emails;
                active-triage-tab <=> root.active-triage-tab;
                active-uid: root.active-email-uid;
                reading-from: root.reading-from;
                reading-subject: root.reading-subject;
                reading-date: root.reading-date;
                reading-body: root.reading-body;
                view-clicked(uid) => { root.view-clicked(uid); }
                reply-clicked(uid) => {
                    root.reply-clicked(uid);
                    root.compose-open = true;
                }
            }

            if root.active-panel == "tasks": TasksPanel {
                width: parent.width;
                height: parent.height;
                task-items: root.task-items;
                active-uid: root.active-email-uid;
                reading-from: root.reading-from;
                reading-subject: root.reading-subject;
                reading-date: root.reading-date;
                reading-body: root.reading-body;
                view-clicked(uid) => { root.view-clicked(uid); }
                reply-clicked(uid) => {
                    root.reply-clicked(uid);
                    root.compose-open = true;
                }
            }

            if root.active-panel == "projects": ProjectsPanel {
                width: parent.width;
                height: parent.height;
                all-emails: root.all-emails;
                all-emails-by-priority: root.all-emails-by-priority;
                projects: root.projects;
                active-uid: root.active-email-uid;
                reading-from: root.reading-from;
                reading-subject: root.reading-subject;
                reading-date: root.reading-date;
                reading-body: root.reading-body;
                view-clicked(uid) => { root.view-clicked(uid); }
                reply-clicked(uid) => {
                    root.reply-clicked(uid);
                    root.compose-open = true;
                }
                save-description(name, desc) => { root.save-description(name, desc); }
            }

            if root.active-panel == "calendar": CalendarPanel {
                width: parent.width;
                height: parent.height;
                deadlines: root.deadlines;
                calendar-year: root.calendar-year;
                calendar-month: root.calendar-month;
                active-uid: root.active-email-uid;
                reading-from: root.reading-from;
                reading-subject: root.reading-subject;
                reading-date: root.reading-date;
                reading-body: root.reading-body;
                view-clicked(uid) => { root.view-clicked(uid); }
                reply-clicked(uid) => {
                    root.reply-clicked(uid);
                    root.compose-open = true;
                }
            }

            if root.active-panel == "sent": FolderPanel {
                width: parent.width; height: parent.height;
                folder-title: "Sent";
                emails: root.sent-emails;
                active-uid: root.active-email-uid;
                reading-from: root.reading-from;
                reading-subject: root.reading-subject;
                reading-date: root.reading-date;
                reading-body: root.reading-body;
                show-reply: false;
                view-clicked(uid) => { root.view-clicked(uid); }
                reply-clicked(uid) => { root.reply-clicked(uid); root.compose-open = true; }
            }

            if root.active-panel == "drafts": FolderPanel {
                width: parent.width; height: parent.height;
                folder-title: "Drafts";
                emails: root.drafts-emails;
                active-uid: root.active-email-uid;
                reading-from: root.reading-from;
                reading-subject: root.reading-subject;
                reading-date: root.reading-date;
                reading-body: root.reading-body;
                show-reply: false;
                view-clicked(uid) => { root.view-clicked(uid); }
                reply-clicked(uid) => { root.reply-clicked(uid); root.compose-open = true; }
            }

            if root.active-panel == "trash": FolderPanel {
                width: parent.width; height: parent.height;
                folder-title: "Trash";
                emails: root.trash-emails;
                active-uid: root.active-email-uid;
                reading-from: root.reading-from;
                reading-subject: root.reading-subject;
                reading-date: root.reading-date;
                reading-body: root.reading-body;
                show-reply: false;
                view-clicked(uid) => { root.view-clicked(uid); }
                reply-clicked(uid) => { root.reply-clicked(uid); root.compose-open = true; }
            }
        }
    }

    // ── Compose Dialog overlay ─────────────────────────────────────────────
    if root.compose-open: ComposeDialog {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        visible-dialog: root.compose-open;
        to-address <=> root.compose-to;
        subject-text <=> root.compose-subject;
        body-text <=> root.compose-body;
        status-message: root.compose-status;

        send-clicked(to, subj, body) => {
            root.send-email(to, subj, body);
        }
        close-clicked => {
            root.compose-open = false;
            root.compose-to = "";
            root.compose-subject = "";
            root.compose-body = "";
            root.compose-status = "";
        }
    }

    // ── Settings Dialog overlay ────────────────────────────────────────────
    if root.settings-open: SettingsDialog {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        accounts: root.settings-accounts;
        display-name: root.settings-display-name;
        claude-key: root.settings-claude-key;
        claude-model: root.settings-claude-model;
        qr-text: root.settings-qr-text;
        save-status: root.settings-save-status;
        font-scale <=> root.font-scale;

        close => { root.settings-open = false; root.settings-save-status = ""; }
        save-all(dname, accs, ckey, cmodel, fscale) => { root.save-settings(dname, accs, ckey, cmodel, fscale); }
        add-account => { root.add-account(); }
        delete-account(idx) => { root.delete-account(idx); }
        request-qr => { root.request-qr(); }
    }
}
