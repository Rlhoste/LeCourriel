import { Theme } from "theme.slint";
import { EmailCard, EmailCardData } from "email_card.slint";
import { ReadingPane } from "reading_pane.slint";
import { ScrollView } from "std-widgets.slint";

// Generic split-view: email list on left, reading pane on right.
export component SplitEmailView inherits Rectangle {
    background: Theme.bg-primary;

    in property <[EmailCardData]> emails;
    in property <int> active-uid: -1;
    in property <string> reading-from;
    in property <string> reading-subject;
    in property <string> reading-date;
    in property <string> reading-body;

    callback view-clicked(int);
    callback reply-clicked(int);

    HorizontalLayout {
        spacing: 0px;

        // Email list
        Rectangle {
            horizontal-stretch: 2;
            background: Theme.bg-sidebar;

            ScrollView {
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    width: parent.visible-width;
                    padding: 12px;
                    spacing: 6px;

                    if emails.length == 0: Text {
                        text: "No emails";
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                    }

                    for email in emails: EmailCard {
                        width: parent.width;
                        card-data: email;
                        view-clicked(uid) => { root.view-clicked(uid); }
                        reply-clicked(uid) => { root.reply-clicked(uid); }
                    }
                }
            }
        }

        Rectangle { width: 1px; background: Theme.border; }

        // Reading pane
        ReadingPane {
            horizontal-stretch: 3;
            has-email: active-uid >= 0;
            from-header: reading-from;
            subject-header: reading-subject;
            date-header: reading-date;
            body-text: reading-body;
            reply-clicked => { root.reply-clicked(active-uid); }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> active;

    callback clicked();

    width: tab-hl.preferred-width + 16px;
    height: 36px;
    border-radius: 0px;
    background: transparent;

    border-color: active ? Theme.accent : transparent;
    border-width: 0;

    Rectangle {
        x: 0;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: active ? Theme.accent : transparent;
    }

    tab-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    tab-hl := HorizontalLayout {
        x: 8px;
        y: 0;
        height: parent.height;
        spacing: 4px;
        alignment: start;

        Text {
            text: label;
            color: active ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.font-sm;
            font-weight: active ? 600 : 400;
            vertical-alignment: center;
        }
        if count > 0: Rectangle {
            width: cnt-txt.preferred-width + 8px;
            height: 16px;
            border-radius: 8px;
            background: active ? Theme.accent : Theme.bg-card;
            y: (36px - 16px) / 2;

            cnt-txt := Text {
                x: 4px; y: 0;
                height: parent.height;
                text: count;
                color: active ? #1a1a1a : Theme.text-muted;
                font-size: Theme.font-xs;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

export component MainPanel inherits Rectangle {
    background: Theme.bg-primary;

    in property <string> greeting;
    in property <string> briefing-time;
    in property <bool> loading;

    in property <[EmailCardData]> urgent-emails;
    in property <[EmailCardData]> high-emails;
    in property <[EmailCardData]> other-emails;
    in property <[EmailCardData]> info-emails;
    in property <[EmailCardData]> threat-emails;
    in property <[EmailCardData]> task-emails;

    in-out property <string> active-triage-tab: "urgent";
    in-out property <int> active-uid: -1;
    in property <string> reading-from;
    in property <string> reading-subject;
    in property <string> reading-date;
    in property <string> reading-body;

    callback reply-clicked(int);
    callback view-clicked(int);

    VerticalLayout {
        spacing: 0px;

        // Top bar
        Rectangle {
            height: 72px;
            background: Theme.bg-primary;

            HorizontalLayout {
                padding-left: 28px;
                padding-right: 24px;
                spacing: 0px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;

                    Text {
                        text: root.greeting;
                        color: Theme.text-primary;
                        font-size: Theme.font-xl;
                        font-weight: 700;
                    }
                    Text {
                        text: root.briefing-time;
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                    }
                }

                if root.loading: Rectangle {
                    width: 90px;
                    height: 30px;
                    border-radius: Theme.radius-md;
                    background: Theme.bg-card;
                    y: (72px - 30px) / 2;

                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 6px;
                        alignment: start;

                        spinner := Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.accent;
                            y: (30px - 8px) / 2;

                            animate opacity {
                                duration: 600ms;
                                iteration-count: -1;
                                direction: alternate;
                                easing: ease-in-out;
                            }
                        }
                        Text {
                            text: "Fetching…";
                            color: Theme.text-secondary;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                            height: 30px;
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // Sub-tab bar
        Rectangle {
            height: 38px;
            background: Theme.bg-sidebar;

            HorizontalLayout {
                padding-left: 16px;
                spacing: 0px;

                TabButton {
                    label: "Urgent";
                    count: urgent-emails.length;
                    active: active-triage-tab == "urgent";
                    clicked => { active-triage-tab = "urgent"; }
                }
                TabButton {
                    label: "High";
                    count: high-emails.length;
                    active: active-triage-tab == "high";
                    clicked => { active-triage-tab = "high"; }
                }
                TabButton {
                    label: "Tasks";
                    count: task-emails.length;
                    active: active-triage-tab == "task";
                    clicked => { active-triage-tab = "task"; }
                }
                TabButton {
                    label: "Threats";
                    count: threat-emails.length;
                    active: active-triage-tab == "threat";
                    clicked => { active-triage-tab = "threat"; }
                }
                TabButton {
                    label: "Other";
                    count: other-emails.length;
                    active: active-triage-tab == "other";
                    clicked => { active-triage-tab = "other"; }
                }
                TabButton {
                    label: "Info";
                    count: info-emails.length;
                    active: active-triage-tab == "info";
                    clicked => { active-triage-tab = "info"; }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // Content based on active tab
        if active-triage-tab == "urgent": SplitEmailView {
            vertical-stretch: 1;
            emails: urgent-emails;
            active-uid: active-uid;
            reading-from: reading-from;
            reading-subject: reading-subject;
            reading-date: reading-date;
            reading-body: reading-body;
            view-clicked(uid) => { root.view-clicked(uid); }
            reply-clicked(uid) => { root.reply-clicked(uid); }
        }
        if active-triage-tab == "high": SplitEmailView {
            vertical-stretch: 1;
            emails: high-emails;
            active-uid: active-uid;
            reading-from: reading-from;
            reading-subject: reading-subject;
            reading-date: reading-date;
            reading-body: reading-body;
            view-clicked(uid) => { root.view-clicked(uid); }
            reply-clicked(uid) => { root.reply-clicked(uid); }
        }
        if active-triage-tab == "task": SplitEmailView {
            vertical-stretch: 1;
            emails: task-emails;
            active-uid: active-uid;
            reading-from: reading-from;
            reading-subject: reading-subject;
            reading-date: reading-date;
            reading-body: reading-body;
            view-clicked(uid) => { root.view-clicked(uid); }
            reply-clicked(uid) => { root.reply-clicked(uid); }
        }
        if active-triage-tab == "threat": SplitEmailView {
            vertical-stretch: 1;
            emails: threat-emails;
            active-uid: active-uid;
            reading-from: reading-from;
            reading-subject: reading-subject;
            reading-date: reading-date;
            reading-body: reading-body;
            view-clicked(uid) => { root.view-clicked(uid); }
            reply-clicked(uid) => { root.reply-clicked(uid); }
        }
        if active-triage-tab == "other": SplitEmailView {
            vertical-stretch: 1;
            emails: other-emails;
            active-uid: active-uid;
            reading-from: reading-from;
            reading-subject: reading-subject;
            reading-date: reading-date;
            reading-body: reading-body;
            view-clicked(uid) => { root.view-clicked(uid); }
            reply-clicked(uid) => { root.reply-clicked(uid); }
        }
        if active-triage-tab == "info": SplitEmailView {
            vertical-stretch: 1;
            emails: info-emails;
            active-uid: active-uid;
            reading-from: reading-from;
            reading-subject: reading-subject;
            reading-date: reading-date;
            reading-body: reading-body;
            view-clicked(uid) => { root.view-clicked(uid); }
            reply-clicked(uid) => { root.reply-clicked(uid); }
        }
    }
}
