import { Theme } from "theme.slint";
import { EmailCard, EmailCardData } from "email_card.slint";
import { ReadingPane } from "reading_pane.slint";
import { ScrollView } from "std-widgets.slint";

export component FolderPanel inherits Rectangle {
    background: Theme.bg-primary;

    in property <string> folder-title;
    in property <[EmailCardData]> emails;
    in-out property <int> active-uid: -1;
    in property <string> reading-from;
    in property <string> reading-subject;
    in property <string> reading-date;
    in property <string> reading-body;
    in property <bool> show-reply: true;

    callback view-clicked(int);
    callback reply-clicked(int);

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: 56px;
            background: Theme.bg-primary;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 16px;

                Text {
                    text: folder-title;
                    color: Theme.text-primary;
                    font-size: Theme.font-xl;
                    font-weight: 700;
                    vertical-alignment: center;
                    height: 56px;
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.emails.length + " messages";
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    height: 56px;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Email list
            Rectangle {
                horizontal-stretch: 2;
                background: Theme.bg-sidebar;

                ScrollView {
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        width: parent.visible-width;
                        padding: 12px;
                        spacing: 6px;

                        if root.emails.length == 0: Text {
                            text: "No messages";
                            color: Theme.text-muted;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                        }

                        for email in root.emails: EmailCard {
                            width: parent.width;
                            card-data: email;
                            view-clicked(uid) => { root.view-clicked(uid); }
                            reply-clicked(uid) => { root.reply-clicked(uid); }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.border; }

            ReadingPane {
                horizontal-stretch: 3;
                has-email: root.active-uid >= 0;
                from-header: reading-from;
                subject-header: reading-subject;
                date-header: reading-date;
                body-text: reading-body;
                reply-clicked => {
                    if (root.show-reply) {
                        root.reply-clicked(root.active-uid);
                    }
                }
            }
        }
    }
}
