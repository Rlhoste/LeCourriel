import { Theme } from "theme.slint";
import { EmailCard, EmailCardData } from "email_card.slint";
import { ReadingPane } from "reading_pane.slint";
import { ScrollView } from "std-widgets.slint";

export component TasksPanel inherits Rectangle {
    background: Theme.bg-primary;

    in property <[EmailCardData]> task-items;
    in-out property <int> active-uid: -1;
    in property <string> reading-from;
    in property <string> reading-subject;
    in property <string> reading-date;
    in property <string> reading-body;

    callback view-clicked(int);
    callback reply-clicked(int);

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: 56px;
            background: Theme.bg-primary;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;

                Text {
                    text: "Tasks";
                    color: Theme.text-primary;
                    font-size: Theme.font-xl;
                    font-weight: 700;
                    vertical-alignment: center;
                    height: 56px;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: task-items.length + " items";
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    height: 56px;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // Split view
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Task list
            Rectangle {
                horizontal-stretch: 2;
                background: Theme.bg-sidebar;

                ScrollView {
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        width: parent.visible-width;
                        padding: 12px;
                        spacing: 6px;

                        if task-items.length == 0: Text {
                            text: "No tasks found";
                            color: Theme.text-muted;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                        }

                        for email in task-items: EmailCard {
                            width: parent.width;
                            card-data: email;
                            view-clicked(uid) => { root.view-clicked(uid); }
                            reply-clicked(uid) => { root.reply-clicked(uid); }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.border; }

            ReadingPane {
                horizontal-stretch: 3;
                has-email: active-uid >= 0;
                from-header: reading-from;
                subject-header: reading-subject;
                date-header: reading-date;
                body-text: reading-body;
                reply-clicked => { root.reply-clicked(active-uid); }
            }
        }
    }
}
