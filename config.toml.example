# Copy this file to config.toml (next to this file) and fill in your details.
# config.toml is git-ignored: it holds your passwords and API keys.

[user]
# Optional: your name for the greeting and the AI. Without it, the name in from_address is used.
display_name = ""
font_scale = 1.0

# One [[accounts]] block per mailbox. The first account is used for sending,
# moving to Trash/Spam and marking read.
[[accounts]]
name = "Personal"

[accounts.imap]
# Gmail: imap.gmail.com · Outlook: outlook.office365.com · Yahoo: imap.mail.yahoo.com
host = "imap.gmail.com"
port = 993
username = "you@gmail.com"
# Gmail: use an App Password (myaccount.google.com/apppasswords)
password = "your-app-password"
mailbox = "INBOX"
fetch_count = 50

[accounts.smtp]
# Port 465 = implicit TLS, 587 = STARTTLS
# Gmail: smtp.gmail.com · Outlook: smtp.office365.com · Yahoo: smtp.mail.yahoo.com
host = "smtp.gmail.com"
port = 587
# Leave username/password empty ("") to reuse the IMAP ones.
username = "you@gmail.com"
password = "your-app-password"
# What recipients see in "From". Empty = just the login email.
from_address = "Your Name <you@gmail.com>"

# AI provider: anthropic | openai | mistral | ollama | custom (any OpenAI-compatible API).
# Easier to set from the app: Settings → AI (with "Load models" and "Test").
[ai]
provider = "anthropic"
model = "claude-opus-4-6"
max_tokens = 300
# base_url = "http://localhost:11434/v1"   # only for ollama (default shown) or custom

# One key per provider (Ollama needs none).
[ai.keys]
anthropic = "sk-ant-api03-..."
# openai = "sk-..."
# mistral = "..."


# Optional: your own GIPHY key for the GIF picker (https://developers.giphy.com/).
# Empty = the key built into the app.
[gifs]
giphy_api_key = ""

# Optional: sync tasks, preferences and AI results with Supabase (each account sees only its own data).
# Easier to set from the app: Settings → Cloud. Passwords and API keys are never uploaded.
# See README → "Cloud sync with Supabase".
# [supabase]
# url = "https://xxxxxxxx.supabase.co"
# anon_key = "eyJ..."

# Optional: projects the AI sorts your emails into.
[[projects]]
name = "Work"
description = "Emails about my job. People: colleagues, management, HR. Keywords: meeting, report, leave."
urgency = "normal"
